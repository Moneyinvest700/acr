<?xml version="1.0" encoding="utf-8"?>
<ripple android:color="?android:colorControlHighlight"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="@color/transparent" />
            <stroke android:width="1.0dip" android:color="@color/material_gray_400" />
        </shape>
    </item>
    <item android:id="@android:id/mask" android:drawable="@color/white">
        <inset android:insetLeft="2.0dip" android:insetRight="2.0dip" android:insetTop="2.0dip" android:insetBottom="2.0dip">
            <shape>
                <solid android:color="@color/transparent" />
                <stroke android:width="1.0dip" android:color="@color/material_gray_400" />
            </shape>
        </inset>
    </item>
</ripple>