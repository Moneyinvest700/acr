<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true" android:drawable="@color/material_gray_400">
        <shape>
            <stroke android:width="0.65dip" android:color="#ffdadada" />
            <corners android:radius="2.0dip" />
            <padding android:left="0.0dip" android:top="0.0dip" android:right="0.0dip" android:bottom="0.0dip" />
        </shape>
    </item>
    <item android:state_checked="true" android:drawable="@color/material_gray_400">
        <shape>
            <stroke android:width="0.65dip" android:color="#ffdadada" />
            <corners android:radius="2.0dip" />
        </shape>
    </item>
    <item android:state_selected="true" android:drawable="@color/material_gray_400">
        <shape>
            <stroke android:width="0.65dip" android:color="#ffdadada" />
            <corners android:radius="2.0dip" />
            <padding android:left="0.0dip" android:top="0.0dip" android:right="0.0dip" android:bottom="0.0dip" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/material_gray_50" />
            <stroke android:width="0.65dip" android:color="@color/material_gray_400" />
            <corners android:radius="2.0dip" />
            <padding android:left="0.0dip" android:top="0.0dip" android:right="0.0dip" android:bottom="0.0dip" />
        </shape>
    </item>
</selector>