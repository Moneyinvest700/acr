<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <stroke android:width="0.0dip" android:color="#ff777777" />
                    <gradient android:startColor="@color/P500" android:endColor="@color/P500" android:angle="270.0" android:centerColor="@color/P500" />
                    <size android:height="15.0dip" android:width="15.0dip" />
                </shape>
            </item>
            <item android:height="1.0dip" android:width="4.0dip" android:left="3.0dip" android:top="9.0dip">
                <rotate android:fromDegrees="45.0">
                    <shape android:shape="rectangle">
                        <solid android:color="#ffffffff" />
                    </shape>
                </rotate>
            </item>
            <item android:height="1.0dip" android:width="8.0dip" android:left="5.0dip" android:top="8.0dip">
                <rotate android:fromDegrees="-45.0">
                    <shape android:shape="rectangle">
                        <solid android:color="#ffffffff" />
                    </shape>
                </rotate>
            </item>
        </layer-list>
    </item>
</selector>