<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="ring" android:innerRadiusRatio="2.8" android:thicknessRatio="11.0" android:useLevel="false">
            <solid android:color="@color/Ng300" />
            <corners android:radius="98.0dip" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <rotate android:fromDegrees="270.0" android:toDegrees="270.0" android:pivotX="50.0%" android:pivotY="50.0%">
            <shape android:shape="ring" android:innerRadiusRatio="2.8" android:thicknessRatio="11.0">
                <corners android:radius="28.0dip" />
                <solid android:color="@color/hp_progress_color" />
            </shape>
        </rotate>
    </item>
</layer-list>