<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:orientation="vertical" android:layout_width="fill_parent" android:layout_height="wrap_content" style="@style/ppfFieldStyle"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <include android:id="@id/ppfFieldHeading" layout="@layout/include_ppf_field_heading" />
    <com.nnacres.app.ppf_revamp.customViewHolders.PPFInputBoxView android:id="@id/expectedPrice" android:layout_width="fill_parent" android:layout_height="wrap_content" />
    <androidx.appcompat.widget.AppCompatTextView android:id="@id/priceInWords" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/extra_small_even" style="@style/captionStrongSmall" />
    <RelativeLayout android:id="@id/pricePerUnitSection" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content">
        <com.nnacres.app.ppf_revamp.customViewHolders.PPFInputBoxView android:id="@id/pricePerUnit" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/large_even" />
        <TextView android:id="@id/pricePerUnitText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/extra_small" android:text="Based on" android:layout_below="@id/pricePerUnit" style="@style/captionStrongSmall" />
        <TextView android:id="@id/areaType" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/extra_small" android:drawablePadding="4.0dip" android:layout_below="@id/pricePerUnit" android:layout_marginStart="@dimen/extra_small_even" android:layout_toEndOf="@id/pricePerUnitText" app:drawableEndCompat="@drawable/ic_blue_drop_down" style="@style/hyperlinkXSmall" />
    </RelativeLayout>
    <LinearLayout android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/large_even">
        <LinearLayout android:id="@id/showPriceInclusive" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content">
            <com.nnacres.app.clickstreamsdk.custom_view.NNCheckbox android:id="@id/inclusivePrice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/pricing_detail_inclusive_price" app:event_type="CLICK" app:identifier="ALL_INCLUSIVE_PRICE" style="@style/secondaryRegularLabel" />
            <ImageView android:layout_gravity="center" android:id="@id/priceInfoIcon" android:layout_width="@dimen/large" android:layout_height="@dimen/large" android:layout_marginLeft="@dimen/extra_small_even" android:src="@drawable/ic_info_outline" />
        </LinearLayout>
        <com.nnacres.app.clickstreamsdk.custom_view.NNCheckbox android:id="@id/upsIncluded" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/pricing_detail_ups_included" style="@style/secondaryRegularLabel" />
        <com.nnacres.app.clickstreamsdk.custom_view.NNCheckbox android:id="@id/electricityExcluded" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/pricing_detail_electricity_included" style="@style/secondaryRegularLabel" />
        <com.nnacres.app.clickstreamsdk.custom_view.NNCheckbox android:id="@id/priceNegotiable" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/pricing_detail_price_negotiable" app:event_type="CLICK" app:identifier="PRICE_NEGOTIABLE" style="@style/secondaryRegularLabel" />
        <com.nnacres.app.clickstreamsdk.custom_view.NNCheckbox android:id="@id/taxExcluded" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/pricing_detail_tax_excluded" app:event_type="CLICK" app:identifier="TAX_GOVT_CHARGES" style="@style/secondaryRegularLabel" />
    </LinearLayout>
    <com.nnacres.app.clickstreamsdk.custom_view.NNTextView android:textColor="@color/P500" android:id="@id/addMorePricingDetail" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/txt_large" android:text="Add more pricing details" android:drawableLeft="@drawable/ic_plus_blue" android:drawablePadding="@dimen/small_even" android:paddingStart="@dimen/small_even" app:event_type="CLICK" app:identifier="ADD_MORE_PRICING_DETAILS" style="@style/buttonTextSmall" />
    <RelativeLayout android:id="@id/showPriceEstimator" android:background="@color/post_property_card_background" android:paddingBottom="@dimen/extra_large_even" android:visibility="gone" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/large_even">
        <ImageView android:id="@id/ivInfo" android:layout_width="@dimen/large_even" android:layout_height="@dimen/large_even" android:layout_marginTop="@dimen/extra_extra_extra_large_even" android:src="@drawable/ic_info_orange" android:layout_marginStart="@dimen/large_even" />
        <ImageView android:layout_gravity="right" android:id="@id/close" android:layout_width="@dimen/large_even" android:layout_height="@dimen/large_even" android:layout_marginTop="@dimen/medium_even" android:src="@drawable/ic_close_black" android:layout_marginEnd="@dimen/medium_even" android:layout_alignParentEnd="true" />
        <TextView android:id="@id/descLabel" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_marginLeft="@dimen/small" android:layout_toRightOf="@id/ivInfo" android:layout_alignTop="@id/ivInfo" style="@style/bodySmall12" />
        <TextView android:id="@id/avgPriceLabel" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/small" android:layout_below="@id/descLabel" android:layout_alignStart="@id/descLabel" style="@style/captionStrongMedium" />
        <TextView android:id="@id/tvEdit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/small" android:text="Edit the price or" android:layout_below="@id/avgPriceLabel" android:layout_alignStart="@id/avgPriceLabel" style="@style/captionStrongMedium" />
        <TextView android:id="@id/tvButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="@dimen/extra_extra_small" android:layout_marginTop="@dimen/small" android:layout_toRightOf="@id/tvEdit" android:layout_below="@id/avgPriceLabel" style="@style/hyperlinkSmall" />
    </RelativeLayout>
    <RelativeLayout android:id="@id/thankyouSection" android:background="@drawable/shape_success_subtle" android:paddingBottom="@dimen/large_even" android:visibility="gone" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/large_even">
        <ImageView android:id="@id/ivThumbsUp" android:layout_width="@dimen/large" android:layout_height="@dimen/large" android:layout_marginLeft="@dimen/large_even" android:layout_marginTop="@dimen/large_even" android:src="@drawable/ic_success_thumbs_up" />
        <TextView android:id="@id/thankyouLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignTop="@id/ivThumbsUp" android:paddingStart="@dimen/small_even" android:paddingEnd="@dimen/medium_even" android:layout_marginEnd="@dimen/large" android:layout_toEndOf="@id/ivThumbsUp" style="@style/bodyMedium" />
        <TextView android:textColor="@color/P500" android:id="@id/tvEditButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="edit" android:layout_below="@id/thankyouLabel" android:paddingStart="@dimen/small_even" android:layout_alignStart="@id/thankyouLabel" style="@style/bodyMedium" />
        <ImageView android:id="@id/thankyouClose" android:layout_width="@dimen/large" android:layout_height="@dimen/large" android:layout_marginRight="@dimen/large_even" android:src="@drawable/ic_close_black" android:layout_alignTop="@id/ivThumbsUp" android:layout_alignParentRight="true" />
    </RelativeLayout>
</LinearLayout>