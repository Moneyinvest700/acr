<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:orientation="vertical" android:layout_width="fill_parent" android:layout_height="wrap_content"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <TextView android:textSize="@dimen/medium" android:textColor="@color/hambuger_text_color" android:id="@id/tv_charge_brokerage" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="@dimen/extra_small" android:layout_marginTop="@dimen/small" android:text="@string/charge_brokerage" android:fontFamily="@font/open_sans" />
    <RadioGroup android:orientation="horizontal" android:id="@id/rg_yes_no" android:tag="@string/charge_brokerage_add" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_marginLeft="@dimen/medium" android:layout_marginTop="@dimen/extra_small" android:layout_marginRight="@dimen/large" android:layout_below="@id/rl_number_container">
        <com.nnacres.app.ui.NNacresAppCompatRadioButton android:textSize="@dimen/medium" android:textColor="@color/hambuger_text_color" android:id="@id/rb_yes" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/yes" />
        <com.nnacres.app.ui.NNacresAppCompatRadioButton android:textSize="@dimen/medium" android:textColor="@color/hambuger_text_color" android:id="@id/rb_no" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="@dimen/extra_extra_large" android:text="@string/no" />
    </RadioGroup>
    <TextView android:textSize="@dimen/medium" android:textColor="@color/hambuger_text_color" android:id="@id/tv_no_brokerage" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="@dimen/extra_small" android:layout_marginTop="@dimen/small" android:text="@string/no_brokerage" android:fontFamily="@font/open_sans" />
    <EditText android:id="@id/brokerage_type" android:tag="@string/brokg_type" android:visibility="gone" android:layout_marginTop="@dimen/small" android:hint="Brokerage Type" style="@style/SearchFormDialogueInputCity" />
    <com.google.android.material.textfield.TextInputLayout android:id="@id/et_brokerage_container" android:visibility="gone" android:layout_width="fill_parent" android:layout_height="fill_parent" android:layout_marginTop="@dimen/small" app:errorTextAppearance="@style/textInputLayoutErrAppearance">
        <EditText android:id="@id/brokerage" android:tag="@string/brokg" android:visibility="gone" android:hint="Brokerage Amount (₹)" android:maxLength="7" android:digits="\ 0123456789" android:inputType="number" android:imeOptions="actionDone" style="@style/MaterialEditTextStyle" />
    </com.google.android.material.textfield.TextInputLayout>
    <com.nnacres.app.ui.NNacresCheckBox android:textSize="@dimen/ppf_checkbox_text" android:textColor="@color/material_gray_800" android:id="@id/brokerage_negotiable" android:tag="@string/brokg_negot" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="@dimen/medium" android:layout_marginTop="@dimen/extra_small" android:text="@string/brokerage_negotiable" android:drawablePadding="@dimen/extra_small" />
</LinearLayout>