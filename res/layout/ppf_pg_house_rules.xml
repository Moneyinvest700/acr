    <RelativeLayout android:layout_width="fill_parent" android:layout_height="wrap_content">
        <TextView android:textSize="@dimen/medium" android:textColor="@color/hambuger_text_color" android:id="@id/tv_events_allowed" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="@dimen/medium" android:layout_marginTop="@dimen/small" android:text="Hosting Events/Parties allowed:" android:fontFamily="@font/open_sans" />
