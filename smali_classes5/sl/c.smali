.class public abstract Lsl/c;
.super Lsl/f;
.source "SourceFile"


# direct methods
.method public constructor <init>()V
    .locals 0

    invoke-direct {p0}, Lsl/f;-><init>()V

    return-void
.end method


# virtual methods
.method protected f()Lsl/h;
    .locals 1

    invoke-super {p0}, Lsl/f;->f()Lsl/h;

    move-result-object v0

    return-object v0
.end method
